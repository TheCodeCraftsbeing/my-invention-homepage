# Copy this file to .env and fill in your values

# Google Gemini API key
GEMINI_API_KEY=

# API secret used by frontend to authorize requests to the API route
# Keep this secret and NEVER expose publicly.
TONE_CHANGER_API_SECRET=
# Legacy fallback name supported by the API (optional)
# API_SECRET_KEY=

# Frontend origin allowed to call the API (CORS)
# Example: https://my-invention-homepage.vercel.app
FRONTEND_ORIGIN=

# Frontend uses these build-time variables injected into templates
# These should match your deployed API route URL and secret
TONE_CHANGER_API_URL=
TONE_CHANGER_API_SECRET=